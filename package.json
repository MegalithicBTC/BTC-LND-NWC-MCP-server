{
  "name": "btc-mcp-srv",
  "version": "0.4.0",
  "description": "MCP server that lets AI agents send and receive Bitcoin over the Lightning Network (NWC + LND). Sponsored by LIGHTPHON.com",
  "type": "module",
  "license": "MIT",
  "bin": {
    "btc-mcp-srv": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "setup": "npm run build && node dist/setup/server.js",
    "fullnode": "npm run build && node dist/setup/fullnode-cli.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bitcoin",
    "lightning",
    "lightning-network",
    "nwc",
    "nostr-wallet-connect",
    "lnd",
    "ai-agents",
    "payments"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightphon/BTC-LND-NWC-MCP-server.git"
  },
  "bugs": {
    "url": "https://github.com/lightphon/BTC-LND-NWC-MCP-server/issues"
  },
  "homepage": "https://lightphon.com",
  "dependencies": {
    "@getalby/sdk": "^8.0.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "light-bolt11-decoder": "^3.2.0",
    "undici": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
