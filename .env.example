# ── Backend selection ────────────────────────────────────────────────
# Which Lightning backend to use: "nwc" or "lnd"
LN_BACKEND=nwc

# ── NWC (Nostr Wallet Connect) ───────────────────────────────────────
# Get one from Alby Hub, coinos, Primal, Mutiny, or any NWC-capable wallet.
# Looks like: nostr+walletconnect://<pubkey>?relay=wss://...&secret=...
NWC_CONNECTION_STRING=

# ── LND (REST) ───────────────────────────────────────────────────────
# Base URL of your LND REST API
LND_REST_URL=https://127.0.0.1:8080
# Hex-encoded macaroon (admin.macaroon for full access, or bake a
# restricted macaroon with only the permissions you want to grant)
LND_MACAROON_HEX=
# Path to LND's tls.cert (recommended). If unset and the cert is
# self-signed, set LND_SKIP_CERT_VERIFY=true (NOT recommended over
# untrusted networks).
LND_TLS_CERT_PATH=
LND_SKIP_CERT_VERIFY=false

# ── Safety limits (strongly recommended for agent use) ───────────────
# Maximum amount (sats) a single pay_invoice / pay_lightning_address
# call may spend. 0 disables outgoing payments entirely.
MAX_SEND_SATS=10000
# Rolling 24h spending budget in sats. 0 = no daily budget.
DAILY_BUDGET_SATS=50000
# Max routing fee as a percentage of the payment amount (LND only)
MAX_FEE_PERCENT=1

# ── Misc ─────────────────────────────────────────────────────────────
# Default expiry for created invoices, in seconds
DEFAULT_INVOICE_EXPIRY=3600
